# DIAG-MAINT V2 — configuration du serveur
# Copier ce fichier en « .env » (même dossier) puis compléter. Le fichier .env n'est jamais versionné.

# --- Fournisseur d'IA ---------------------------------------------------------
# auto : Anthropic si une clé est présente, sinon moteur local (sans IA)
AI_PROVIDER=auto

# Clé d'API Anthropic (https://console.anthropic.com → API Keys). Ne jamais la mettre dans le frontend.
ANTHROPIC_API_KEY=

# Modèle et effort (laisser vide = valeurs par défaut recommandées)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max
# ANTHROPIC_MAX_TOKENS=16000
# ANTHROPIC_FALLBACKS=default    # repli automatique si le modèle refuse ; "off" pour désactiver

# Recherche Web par l'agent (outils serveur Anthropic)
# WEB_SEARCH=true
# WEB_SEARCH_MAX_USES=5

# --- Serveur -------------------------------------------------------------------
# PORT=8787
# HOST=127.0.0.1                 # 0.0.0.0 pour l'utiliser depuis un téléphone sur le même réseau
# Jeton d'accès applicatif, OBLIGATOIRE dès que le serveur est accessible depuis le réseau.
# À saisir dans l'application : Réglages → Serveur IA.
APP_ACCESS_TOKEN=
# Origines autorisées à appeler l'API (site GitHub Pages…), séparées par des virgules
# ALLOWED_ORIGINS=https://lucas-66126.github.io
# DATA_DIR=./data
# MAX_UPLOAD_MB=25
